# ─────────────────────────────────────────────────────────────────────────
# FRONTEND environment — TAMIS АГРО (React 19 + Vite/CRA-style)
# Copy this file to frontend/.env and fill in real values.
# ─────────────────────────────────────────────────────────────────────────

# Public URL of the backend API.
# In dev with the bootstrap script: http://localhost:8001
# In Emergent preview: https://<slug>.preview.emergentagent.com
REACT_APP_BACKEND_URL=http://localhost:8001

# Webpack DevServer config — leave as is when running locally.
WDS_SOCKET_PORT=443
ENABLE_HEALTH_CHECK=false
