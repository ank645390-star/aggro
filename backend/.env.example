# ─────────────────────────────────────────────────────────────────────────
# BACKEND environment — TAMIS АГРО (FastAPI + MongoDB)
# Copy this file to backend/.env and fill in real values.
# ─────────────────────────────────────────────────────────────────────────

# ── Core (REQUIRED) ──────────────────────────────────────────────────────
# MongoDB connection string. For local dev use localhost; for production
# point to your managed cluster (Atlas / self-hosted).
MONGO_URL="mongodb://localhost:27017"

# Logical database name inside MongoDB.
DB_NAME="tamis_agro"

# Comma-separated list of allowed CORS origins. Use "*" for dev.
CORS_ORIGINS="*"

# Public base URL of the deployed site (used for absolute links
# inside emails, OG tags, sitemaps, payment redirects, etc.).
SITE_BASE_URL="http://localhost:3000"

# ── Auth / JWT ───────────────────────────────────────────────────────────
# Used for both the customer and admin token signatures.
# Generate a strong random string: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_ALG="HS256"
JWT_EXPIRES_DAYS="30"

# ── Upload directories (optional — defaults are sensible) ────────────────
# Where blog images / review photos / product images / payment proofs
# are stored on disk. Paths are relative to the backend working dir.
UPLOAD_DIR="uploads/blog"
REVIEWS_UPLOAD_DIR="uploads/reviews"
PRODUCTS_UPLOAD_DIR="uploads/products"
PAYMENT_PROOF_DIR="uploads/payment_proofs"

# ── Third-party integrations (OPTIONAL — features auto-disable
#    if the corresponding key is missing) ─────────────────────────────────

# Nova Poshta — Ukrainian delivery (cities/warehouses lookups).
# Get one here: https://developers.novaposhta.ua/
NOVA_POSHTA_API_KEY=""

# Stripe — card payments (test or live secret key).
STRIPE_API_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Google OAuth — "Sign in with Google" for customers.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:8001/api/auth/google/callback"

# Emergent LLM universal key — used by AI helpers (blog drafts,
# product description rewrites, etc.). Leave empty to disable.
EMERGENT_LLM_KEY=""
